APP_NAME=ClubMatiasMegiasNavarro API
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:change_me@localhost:5432/club_matias_megias_navarro

JWT_SECRET_KEY=replace-with-a-secure-random-value-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

FIREBASE_CREDENTIALS_PATH=backend/firebase-admin-key.json
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
REMINDER_INTERNAL_SECRET=replace-with-a-secure-random-value

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

RECOVERY_NOTIFIER_PROVIDER=development
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Club Matias Megias Navarro
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT_SECONDS=10